# Telegram API (https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash

# Bot token từ @BotFather
BOT_TOKEN=123456:ABC-DEF...

# User ID được phép dùng bot (để trống = tự lấy từ test_session khi chạy)
ALLOWED_USER_IDS=123456789

# Session userbot CŨ — copy file test_session.session từ tool userbot vào cùng thư mục
USER_SESSION=test_session

# Nhóm chứa ads — BOT phải được thêm vào nhóm này để copy ads ra kênh
ADS_CHAT=-1001234567890

# (Tùy chọn) thay cho file .session
# SESSION_STRING=
