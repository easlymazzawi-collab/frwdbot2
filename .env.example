# Telegram API (https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash

# Bot token từ @BotFather
BOT_TOKEN=123456:ABC-DEF...

# User ID được phép dùng bot (lấy từ @userinfobot), phân cách bằng dấu phẩy
ALLOWED_USER_IDS=123456789

# Nhóm chứa ads — bot phải được thêm vào nhóm này
ADS_CHAT=-1001234567890

# (Tùy chọn) User session để /botadd /botaddf — mời bot vào kênh + cấp admin
# Cách 1: export string session
# SESSION_STRING=
# Cách 2: file session (tên mặc định user_session.session)
# USER_SESSION=user_session
